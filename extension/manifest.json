{
  "manifest_version": 3,
  "name": "Kero Translate - YouTube Live Translation & Comment Assist",
  "version": "0.2.3",
  "version_name": "0.2.3",
  "minimum_chrome_version": "116",
  "description": "EN / JA captions and comment drafting. INSERT never sends.",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepgram.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.deepl.com/*",
    "https://api-free.deepl.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeroTranslate",
    "default_icon": "assets/kero-frog.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/*.js",
        "ui/*.js",
        "youtube.js",
        "assets/kero-frog.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://generativelanguage.googleapis.com wss://api.deepgram.com https://api.openai.com https://api.deepseek.com https://api.deepl.com https://api-free.deepl.com wss://api.deepl.com"
  },
  "short_name": "Kero Translate"
}
